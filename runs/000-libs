#!/bin/bash

git clone https://aur.archlinux.org/paru.git
cd paru
makepkg -si --noconfirm
cd ..
rm -rf paru

sudo pacman -S --noconfirm base-devel gnome-keyring egl-wayland btop playerctl less unzip ntfs-3g feh vlc gnome-themes-extra adobe-source-code-pro-fonts ttf-font-awesome ttf-jetbrains-mono-nerd ttf-nerd-fonts-symbols ttf-roboto

git config --global credential.helper libsecret
